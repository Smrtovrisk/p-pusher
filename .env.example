# Financial Modeling Prep API key (free: https://site.financialmodelingprep.com/pricing-plans)
FMP_API_KEY=your_api_key_here

# ntfy.sh topic - pick something hard to guess (it's public by name)
# Example: pelosi-trades-a7x9k2
NTFY_TOPIC=your-secret-topic-here

# Polling interval in minutes (default: 30)
# 250 free API calls/day = every 6 min max, but trades are disclosed days late so 30 is fine
POLL_INTERVAL_MINUTES=30

# Politicians to track (comma-separated)
# Uses the FMP house-trades-by-name endpoint
POLITICIANS=Nancy Pelosi
